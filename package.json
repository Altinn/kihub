{
  "name": "kihub",
  "version": "0.1.0",
  "private": true,
  "description": "KI Hub — internal AI enablement and governance platform (catalog + governance layer over Git-based artifacts).",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"],
    "overrides": {
      "undici": "^7.29.0",
      "dompurify": "^3.4.12",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
