---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

const { hasSidebar } = Astro.locals.starlightRoute;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

const footerLinks = [
  { label: "Om KITT", href: "/om-kitt/" },
  { label: "Verktøy", href: "/tools/" },
  { label: "Prosjekter", href: "/prosjekter/" },
  { label: "Nyheter", href: "/nyheter/" },
];
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>

  <footer class="kihub-site-footer">
    <div class="starlight-footer-tools">
      <div class="meta sl-flex">
        <EditLink />
        <LastUpdated />
      </div>
      <Pagination />
    </div>

    <div class="kihub-footer-inner">
      <button class="kihub-footer-brand kitt-easter-egg" id="kitt-easter-egg" aria-label="Gi KITT litt kjærlighet">
        <span class="kihub-footer-mark" aria-hidden="true">
          <img src={withBase('/images/kitt-emblem.svg')} alt="KITT" height="28" style="width:auto;position:relative;top:0.5mm" />
        </span>
      </button>

      <div class="kihub-footer-contact">
        <p>Kontakt oss:</p>
        <a class="ds-focus" href="mailto:kitt@digdir.no">kitt@digdir.no</a>
      </div>

      <nav class="kihub-footer-links" aria-label="Bunnlenker">
        {footerLinks.map((link) => (
          <a class="ds-focus" href={withBase(link.href)}>{link.label}</a>
        ))}
      </nav>
    </div>
  </footer>
</div>

<script>
  // KITT easter egg — sonar ripple on click
  const easterEgg = document.getElementById('kitt-easter-egg') as HTMLButtonElement | null;
  if (easterEgg) {
    easterEgg.addEventListener('click', () => {
      [0, 220].forEach((delay) => {
        setTimeout(() => {
          const r = document.createElement('span');
          r.className = 'kitt-ripple';
          easterEgg.appendChild(r);
          r.addEventListener('animationend', () => r.remove());
        }, delay);
      });
    });
  }

  // Keep sidebar bottom aligned with footer top so items are never hidden behind the footer.
  const footer = document.querySelector('.kihub-site-footer') as HTMLElement | null;
  if (footer) {
    const update = () => {
      document.documentElement.style.setProperty(
        '--kihub-footer-height',
        `${footer.offsetHeight}px`
      );
    };
    update();
    new ResizeObserver(update).observe(footer);
  }
</script>

<style>
  .kitt-easter-egg {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
    color: inherit;
    font: inherit;
    position: relative;
  }

  .kitt-easter-egg {
    overflow: visible;
  }

  @keyframes kitt-sonar {
    from { opacity: 0.6; transform: translate(-50%, -50%) scale(0); }
    to   { opacity: 0;   transform: translate(-50%, -50%) scale(4); }
  }

  :global(.kitt-ripple) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--ds-color-accent-text-default);
    pointer-events: none;
    animation: kitt-sonar 0.75s ease-out forwards;
  }

  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      flex-grow: 1;
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
        /* End the sidebar above the footer so it doesn't overlap */
        inset-block-end: var(--kihub-footer-height, 130px);
      }
    }
  }
</style>
