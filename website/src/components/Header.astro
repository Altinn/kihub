---
import Search from 'virtual:starlight/components/Search';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const normalizePath = (path: string) => {
  const withoutBase =
    base !== '/' && path.startsWith(base) ? path.slice(base.length - 1) : path;
  return withoutBase.endsWith('/') ? withoutBase : `${withoutBase}/`;
};

const currentPath = normalizePath(Astro.url.pathname);
const navItems = [
  { label: 'Hjem', href: '/' },
  { label: 'Verktøy', href: '/tools/' },
  { label: 'KI Læring', href: '/learning-hub/' },
  { label: 'Prosjekter', href: '/prosjekter/' },
  { label: 'Nyheter', href: '/nyheter/' },
  { label: 'Om KITT', href: '/om-kitt/' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="kihub-header" data-color="accent">
  <a class="kihub-brand ds-focus" href={withBase('/')} aria-label="KI HUB hjem">
    <span class="kihub-brand-mark" aria-hidden="true">
      <img src={withBase('/images/kitt-emblem.svg')} alt="" height="28" style="width:auto;position:relative;top:0.5mm" />
    </span>
    <span class="kihub-brand-text">KI HUB</span>
  </a>

  <nav class="kihub-desktop-nav" aria-label="Hovednavigasjon">
    {
      navItems.map((item) => (
        <a
          class="kihub-nav-link ds-focus"
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-home-link={item.href === '/' ? 'true' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="kihub-actions">
    <Search class="kihub-search" />
    <a class="ds-button kihub-login" data-variant="secondary" href={withBase('/login/')}>
      Logg inn
    </a>
    <button
      type="button"
      class="kihub-menu-button ds-focus"
      aria-expanded="false"
      aria-controls="kihub-mobile-nav"
      aria-label="Åpne meny"
    >
      <svg class="kihub-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="kihub-close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
</div>

<div id="kihub-mobile-nav" class="kihub-mobile-panel" data-color="accent" hidden>
  <nav class="kihub-mobile-nav" aria-label="Hovednavigasjon mobil">
    {
      navItems.map((item) => (
        <a
          class="kihub-mobile-link ds-focus"
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.kihub-menu-button');
  const mobilePanel = document.querySelector<HTMLElement>('#kihub-mobile-nav');

  const setMenuState = (isOpen: boolean) => {
    if (!menuButton || !mobilePanel) return;
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Lukk meny' : 'Åpne meny');
    mobilePanel.hidden = !isOpen;
    document.body.toggleAttribute('data-kihub-menu-open', isOpen);
  };

  menuButton?.addEventListener('click', () => {
    setMenuState(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  mobilePanel?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      setMenuState(false);
    }
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuState(false);
      menuButton?.focus();
    }
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setMenuState(false);
  });
</script>

<style>
  :global(.header:has(.kihub-header)) {
    position: static !important;
    inset: auto !important;
    border-bottom: 0 !important;
    background: var(--ds-color-accent-background-default) !important;
    box-shadow: none !important;
  }

  :global(.page:has(.kihub-header) > .main-frame) {
    padding-top: 0 !important;
  }

  .kihub-header {
    --kihub-nav-red: var(--ds-color-text-default);
    --kihub-search-size: calc(var(--ds-size-12) * 0.85);
    --kihub-search-icon-size: calc(var(--ds-size-7) * 0.85);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--ds-size-5);
    height: 100%;
    width: min(calc(100% - (var(--ds-size-8) * 2)), 1220px);
    max-width: 100%;
    margin: 0 auto;
    background: transparent;
  }

  .kihub-brand,
  .kihub-nav-link,
  .kihub-mobile-link {
    border-radius: var(--ds-border-radius-sm);
    text-decoration: none;
  }

  .kihub-brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: calc(var(--ds-size-5) + 6mm);
    min-width: max-content;
    color: var(--ds-color-text-default);
    font-weight: var(--ds-font-weight-medium);
    margin-left: 32px;
  }

  .kihub-brand:hover {
    color: var(--kihub-nav-red);
  }

  .kihub-brand-mark {
    display: grid;
    place-items: center;
    width: var(--ds-size-9);
    height: var(--ds-size-9);
  }

  .kihub-brand-mark svg {
    width: 100%;
    height: 100%;
  }

  .kihub-brand-mark rect {
    fill: var(--kihub-nav-red);
  }

  .kihub-brand-mark path {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .kihub-brand-text {
    white-space: nowrap;
    font-size: 22px;
  }

  .kihub-desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--ds-size-1);
    min-width: 0;
  }

  .kihub-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--ds-color-text-default);
    font-size: var(--ds-font-size-4);
    font-weight: var(--ds-font-weight-medium);
    padding-block: var(--ds-size-2);
    padding-inline: var(--ds-size-5);
    white-space: nowrap;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .kihub-nav-link:hover {
    border-bottom-color: var(--ds-color-base-hover);
    color: var(--ds-color-base-hover);
  }

  .kihub-nav-link[aria-current='page'] {
    border-bottom-color: var(--ds-color-base-hover);
    border-bottom-width: 3px;
    color: var(--ds-color-base-hover);
  }

  .kihub-nav-link[data-home-link='true'][aria-current='page'] {
    border-bottom-color: transparent;
    border-bottom-width: 2px;
    color: var(--ds-color-text-default);
  }

  .kihub-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--ds-size-4);
  }

  .kihub-login {
    --dsc-button-border-color: var(--kihub-nav-red);
    --dsc-button-color: var(--kihub-nav-red);
    --dsc-button-color--hover: var(--kihub-nav-red);
    --dsc-button-background--hover: color-mix(in srgb, var(--kihub-nav-red) 8%, transparent);
    min-height: var(--ds-size-10);
    padding-inline: var(--ds-size-5);
    font-weight: var(--ds-font-weight-bold);
  }

  .kihub-login {
    display: none;
  }

  .kihub-menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--ds-size-11);
    height: var(--ds-size-11);
    padding: 0;
    border: 0;
    border-radius: var(--ds-border-radius-full);
    background: transparent;
    color: var(--ds-color-text-default);
    cursor: pointer;
  }

  .kihub-menu-button svg {
    width: var(--ds-size-6);
    height: var(--ds-size-6);
  }

  .kihub-menu-button path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .kihub-menu-button[aria-expanded='true'] .kihub-menu-icon,
  .kihub-menu-button:not([aria-expanded='true']) .kihub-close-icon {
    display: none;
  }

  .kihub-mobile-panel {
    position: fixed;
    z-index: calc(var(--sl-z-index-navbar) - 1);
    inset: var(--sl-nav-height) 0 auto;
    padding: var(--ds-size-7) var(--sl-nav-pad-x) var(--ds-size-9);
    border-bottom: var(--ds-border-width-default) solid
      color-mix(in srgb, var(--ds-color-base-default) 42%, transparent);
    background: var(--ds-color-background-default);
    box-shadow: none;
  }

  .kihub-mobile-panel[hidden] {
    display: none;
  }

  .kihub-mobile-nav {
    display: grid;
    gap: var(--ds-size-4);
    max-width: 44rem;
    margin: 0 auto;
  }

  .kihub-mobile-link {
    position: relative;
    display: inline-flex;
    width: fit-content;
    align-items: flex-start;
    padding: var(--ds-size-2) var(--ds-size-3);
    border-bottom: 3px solid transparent;
    color: var(--ds-color-text-default);
    font-size: var(--ds-font-size-6);
    font-weight: var(--ds-font-weight-medium);
    line-height: 1.15;
  }

  .kihub-mobile-link:hover,
  .kihub-mobile-link[aria-current='page'] {
    border-bottom-color: var(--ds-color-base-hover);
    color: var(--ds-color-base-hover);
  }

  .kihub-header :global(site-search button[data-open-modal]),
  .kihub-mobile-panel :global(site-search button[data-open-modal]) {
    width: var(--kihub-search-size);
    height: var(--kihub-search-size);
    min-height: var(--kihub-search-size);
    padding: 0;
    border: 0;
    border-radius: var(--ds-border-radius-full);
    background: transparent;
    color: var(--ds-color-text-default);
    justify-content: center;
  }

  .kihub-header :global(site-search button[data-open-modal] svg),
  .kihub-mobile-panel :global(site-search button[data-open-modal] svg) {
    width: var(--kihub-search-icon-size);
    height: var(--kihub-search-icon-size);
  }

  .kihub-header :global(site-search button[data-open-modal]:hover),
  .kihub-mobile-panel :global(site-search button[data-open-modal]:hover) {
    background: var(--ds-color-surface-hover);
    color: var(--ds-color-text-default);
  }

  .kihub-header :global(site-search button[data-open-modal]:focus-visible),
  .kihub-mobile-panel :global(site-search button[data-open-modal]:focus-visible) {
    box-shadow: var(--dsc-focus-boxShadow);
    outline: var(--dsc-focus-outline);
    outline-offset: var(--ds-border-width-focus);
  }

  .kihub-header :global(site-search button[data-open-modal] span),
  .kihub-header :global(site-search button[data-open-modal] kbd),
  .kihub-mobile-panel :global(site-search button[data-open-modal] span),
  .kihub-mobile-panel :global(site-search button[data-open-modal] kbd) {
    display: none !important;
  }

  @media (max-width: 960px) {
    .kihub-header {
      width: min(calc(100% - (var(--ds-size-5) * 2)), 1220px);
      gap: var(--ds-size-5);
    }

    .kihub-desktop-nav {
      gap: var(--ds-size-5);
    }
  }

  @media (max-width: 767.98px) {
    .kihub-header {
      grid-template-columns: 1fr auto;
      width: min(calc(100% - (var(--ds-size-4) * 2)), 1220px);
    }

    .kihub-desktop-nav,
    .kihub-actions .kihub-login {
      display: none;
    }

    .kihub-menu-button {
      display: inline-flex;
    }

    .kihub-menu-button {
      width: var(--ds-size-12);
      height: var(--ds-size-12);
      min-height: var(--ds-size-12);
    }

    .kihub-menu-button svg {
      width: var(--ds-size-7);
      height: var(--ds-size-7);
    }
  }
</style>

<style is:global>
  @media (max-width: 767.98px) {
    body[data-kihub-menu-open]::before {
      position: fixed;
      z-index: calc(var(--sl-z-index-navbar) - 2);
      inset: var(--sl-nav-height) 0 0;
      background: color-mix(in srgb, var(--ds-color-text-default) 18%, transparent);
      backdrop-filter: blur(5px);
      content: '';
      pointer-events: none;
    }

    body[data-kihub-menu-open] {
      overflow: hidden;
    }
  }

  starlight-menu-button {
    display: none;
  }
</style>
