---
import {
  TYPE_COLORS,
  TYPE_LABELS,
  formatEventDayPadded,
  formatEventMonthLong,
  formatEventYear,
  formatEventWeekdayShort,
  formatEventTime,
  formatEventShortDate,
  generateIcsDataUrl,
  getEventUrl,
  getUpcomingEvents,
  getSpotsLabel,
  isEventFull,
} from "../lib/events";

const base = import.meta.env.BASE_URL;
const events = await getUpcomingEvents();
const nextEvent = events[0];
const upcoming = events.slice(1, 5);

if (!nextEvent) return;

const next = nextEvent.data;
const nextColors = TYPE_COLORS[next.type];
const nextTypeLabel = TYPE_LABELS[next.type];
const nextDay = formatEventDayPadded(next.startDateTime);
const nextMonthYear = `${formatEventMonthLong(next.startDateTime)} ${formatEventYear(next.startDateTime)}`;
const nextWeekday = formatEventWeekdayShort(next.startDateTime);
const nextTime = formatEventTime(next.startDateTime);
const nextIcs = generateIcsDataUrl(nextEvent);
const nextUrl = getEventUrl(base, nextEvent);
const spotsLabel = getSpotsLabel(nextEvent);
const isFull = isEventFull(nextEvent);
---

<section class="ev-section" aria-labelledby="ev-heading">
  <div class="ev-header">
    <div>
      <p class="ev-kicker">Arrangementer</p>
      <h2 id="ev-heading">Hva skjer i BOD</h2>
    </div>
    <a class="ev-all-link ds-focus" href={`${base}arrangementer/`}>
      Se kalender
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>

  <div class="ev-grid">
    <!-- Featured next event -->
    <div class="ev-featured">
      <div class="ev-banner">
        <p class="ev-banner-label">Neste arrangement</p>
        <div class="ev-banner-date">
          <span class="ev-banner-day">{nextDay}</span>
          <span class="ev-banner-rest">
            <span class="ev-banner-month">{nextMonthYear}</span>
            <span class="ev-banner-time">{nextWeekday} · {nextTime}</span>
          </span>
        </div>
      </div>

      <div class="ev-card">
        <span
          class="ev-type-badge"
          style={`color: ${nextColors.text}; background: ${nextColors.tint};`}
        >
          {nextTypeLabel}
        </span>

        <h3 class="ev-card-title">
          <a href={nextUrl} class="ds-focus ev-card-title-link">{next.title}</a>
        </h3>

        <p class="ev-card-meta">
          <svg class="ev-meta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {next.locationName}{next.organizer ? ` · ${next.organizer}` : ""}
        </p>

        <div class="ev-card-actions">
          {next.registrationOpen && next.registrationUrl && !isFull ? (
            <a
              class="ev-register-btn ds-focus"
              href={next.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Meld deg på
            </a>
          ) : isFull ? (
            <span class="ev-register-btn ev-register-btn--full" aria-disabled="true">
              {spotsLabel}
            </span>
          ) : null}

          <a
            class="ev-calendar-link ds-focus"
            href={nextIcs}
            download={`${nextEvent.id}.ics`}
          >
            + Legg til i kalender
          </a>
        </div>
      </div>
    </div>

    <!-- Upcoming events timeline -->
    {upcoming.length > 0 && (
      <div class="ev-timeline-panel">
        <p class="ev-timeline-label">Utover måneden</p>
        <ul class="ev-timeline" role="list">
          {upcoming.map((event) => {
            const colors = TYPE_COLORS[event.data.type];
            const typeLabel = TYPE_LABELS[event.data.type];
            const url = getEventUrl(base, event);
            return (
              <li class="ev-timeline-item">
                <a href={url} class="ev-timeline-link ds-focus">
                  <span
                    class="ev-dot"
                    style={`background: ${colors.text};`}
                    aria-hidden="true"
                  ></span>
                  <span class="ev-item-date">
                    <span class="ev-item-day">{formatEventShortDate(event.data.startDateTime)}</span>
                    <span class="ev-item-time">{formatEventTime(event.data.startDateTime)}</span>
                  </span>
                  <span class="ev-item-info">
                    <span class="ev-item-title">{event.data.title}</span>
                    <span class="ev-item-meta">
                      {typeLabel} · {event.data.locationName}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .ev-section {
    margin-top: var(--ds-size-10);
  }

  .ev-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--ds-size-6);
    margin-bottom: var(--ds-size-6);
  }

  .ev-kicker {
    margin: 0 0 var(--ds-size-2);
    color: var(--ds-color-accent-text-subtle);
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .ev-header h2 {
    margin: 0;
    color: var(--ds-color-accent-text-default);
    font-size: var(--ds-heading-lg-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    line-height: 1.12;
  }

  .ev-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
    min-height: var(--ds-size-10);
    padding: 0 var(--ds-size-4);
    border: var(--ds-border-width-default) solid var(--ds-color-accent-border-default);
    border-radius: var(--ds-border-radius-full);
    color: var(--ds-color-accent-text-subtle) !important;
    font-size: var(--ds-body-md-font-size);
    font-weight: var(--ds-font-weight-bold);
    text-decoration: none !important;
    white-space: nowrap;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ev-all-link:hover {
    border-color: var(--ds-color-accent-border-strong);
    color: var(--ds-color-accent-text-default) !important;
  }

  .ev-all-link svg {
    width: var(--ds-size-5);
    height: var(--ds-size-5);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  /* Grid layout */
  .ev-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: var(--ds-size-8);
    align-items: start;
  }

  /* Featured card */
  .ev-featured {
    display: flex;
    flex-direction: column;
    border-radius: var(--ds-border-radius-lg, 12px);
    overflow: hidden;
    box-shadow: var(--ds-shadow-md);
  }

  .ev-banner {
    padding: var(--ds-size-7) var(--ds-size-7) var(--ds-size-6);
    background: var(--ds-color-accent-base-default);
    color: var(--ds-color-accent-base-contrast-default);
  }

  .ev-banner-label {
    margin: 0 0 var(--ds-size-4);
    font-size: var(--ds-body-xs-font-size, var(--ds-body-sm-font-size));
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .ev-banner-date {
    display: flex;
    align-items: center;
    gap: var(--ds-size-5);
  }

  .ev-banner-day {
    font-size: 4.5rem;
    font-weight: var(--ds-font-weight-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ev-banner-rest {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
  }

  .ev-banner-month {
    font-size: var(--ds-body-lg-font-size);
    font-weight: var(--ds-font-weight-medium);
    line-height: 1.2;
  }

  .ev-banner-time {
    font-size: var(--ds-body-md-font-size);
    opacity: 0.75;
  }

  .ev-card {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    margin-top: 0;
    padding: var(--ds-size-6) var(--ds-size-7) var(--ds-size-7);
    background: var(--ds-color-neutral-surface-default, #fff);
  }

  .ev-type-badge {
    align-self: flex-start;
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: var(--ds-border-radius-sm);
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: var(--ds-body-short-sm-line-height, 1.5);
  }

  .ev-card-title {
    margin: 0;
    font-size: var(--ds-heading-md-font-size);
    font-weight: var(--ds-font-weight-bold);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .ev-card-title-link {
    color: var(--ds-color-accent-text-default) !important;
    text-decoration: none !important;
  }

  .ev-card-title-link:hover {
    text-decoration: underline !important;
    text-decoration-thickness: 0.06em !important;
    text-underline-offset: 0.12em !important;
  }

  .ev-card-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-sm-font-size);
    line-height: var(--ds-body-short-sm-line-height, 1.5);
  }

  .ev-meta-icon {
    flex-shrink: 0;
    width: var(--ds-size-4);
    height: var(--ds-size-4);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .ev-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ds-size-3);
    margin-top: var(--ds-size-2);
  }

  .ev-register-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--ds-size-12);
    padding: 0 var(--ds-size-5);
    border-radius: var(--ds-border-radius-default);
    background: var(--ds-color-accent-base-default);
    color: var(--ds-color-accent-base-contrast-default) !important;
    font-size: var(--ds-body-md-font-size);
    font-weight: var(--ds-font-weight-bold);
    text-decoration: none !important;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .ev-register-btn:hover:not([aria-disabled]) {
    background: var(--ds-color-accent-base-hover);
  }

  .ev-register-btn--full {
    background: var(--ds-color-neutral-surface-hover, #f0f0f0);
    color: var(--ds-color-neutral-text-subtle) !important;
    cursor: default;
  }

  .ev-calendar-link {
    align-self: center;
    color: var(--ds-color-accent-text-default) !important;
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-medium);
    text-decoration: none !important;
  }

  .ev-calendar-link:hover {
    text-decoration: underline !important;
    text-decoration-thickness: 0.06em !important;
    text-underline-offset: 0.12em !important;
  }

  /* Timeline panel */
  .ev-timeline-panel {
    padding-top: var(--ds-size-2);
  }

  .ev-timeline-label {
    margin: 0 0 var(--ds-size-4);
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ev-timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Vertical line connecting all dots */
  .ev-timeline::before {
    content: '';
    position: absolute;
    /* Center of the dot: dot is 12px (size-3) left-aligned in 16px (size-4) col → center at 6px */
    left: 5px;
    top: var(--ds-size-9);    /* ~36px — roughly center of first dot */
    bottom: var(--ds-size-9);
    width: 1px;
    background: var(--ds-color-neutral-border-subtle);
  }

  .ev-timeline-item {
    position: relative;
    margin: 0;
  }

  /* Shortened separator — starts after the dot column, skips first item */
  .ev-timeline-item:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 0;
    /* dot col (size-4=16px) + gap (size-4=16px) = 32px → start of date column */
    left: calc(var(--ds-size-4) + var(--ds-size-4));
    right: 0;
    height: 1px;
    background: var(--ds-color-neutral-border-subtle);
  }

  .ev-timeline-link {
    display: grid;
    grid-template-columns: var(--ds-size-4) var(--ds-size-18, 80px) 1fr;
    align-items: center;
    gap: var(--ds-size-4);
    padding: var(--ds-size-4) 0;
    color: var(--ds-color-accent-text-default) !important;
    text-decoration: none !important;
    transition: background 0.1s ease;
  }

  .ev-timeline-link:hover .ev-item-title {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .ev-dot {
    position: relative;
    z-index: 1;
    width: var(--ds-size-3);
    height: var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    flex-shrink: 0;
  }

  .ev-item-date {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ev-item-day {
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-bold);
    line-height: 1.3;
    white-space: nowrap;
  }

  .ev-item-time {
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-sm-font-size);
    line-height: 1.3;
  }

  .ev-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ev-item-title {
    font-size: var(--ds-body-md-font-size);
    font-weight: var(--ds-font-weight-bold);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ev-item-meta {
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-sm-font-size);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ev-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .ev-grid {
      grid-template-columns: 1fr;
      gap: var(--ds-size-6);
    }

    .ev-timeline-panel {
      padding-top: 0;
    }

    .ev-item-title {
      white-space: normal;
    }

    .ev-item-meta {
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .ev-banner-day {
      font-size: 3.5rem;
    }

    .ev-timeline-link {
      grid-template-columns: var(--ds-size-4) 72px 1fr;
      gap: var(--ds-size-3);
    }
  }
</style>
