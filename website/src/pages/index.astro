---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Modal from '../components/Modal.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { id: 'agents', title: 'Agents', desc: 'Custom agents', countId: 'agents', countText: 'skills', image: 'images/agents.svg' },
  { id: 'instructions', title: 'Instructions', desc: 'Coding standards', countId: 'instructions', countText: 'instructions', image: 'images/instructions.svg' },
  { id: 'skills', title: 'Skills', desc: 'Self-contained instructions', countId: 'skills', countText: 'skills', image: 'images/skills.svg' },
  { id: 'hooks', title: 'Hooks', desc: 'Automated workflows', countId: 'hooks', countText: 'hooks', image: 'images/hooks.svg' },
  { id: 'workflows', title: 'Workflows', desc: 'AI-powered automations', countId: 'workflows', countText: 'workflows', image: 'images/workflows.svg' },
  { id: 'plugins', title: 'Plugins', desc: 'Curated plugins', countId: 'plugins', countText: 'plugins', image: 'images/plugins.svg' },
  { id: 'tools', title: 'Tools', desc: 'MCP servers', countId: 'tools', countText: 'tools', image: 'images/tools.svg' },
  { id: 'learning-hub', title: 'Learning Hub', desc: 'Articles and guides', countId: null, countText: 'articles', image: 'images/learninghub.svg' },
];
---

<StarlightPage
  frontmatter={{
    title: 'DigDir KI HUB',
    description: 'Community-contributed agents, instructions, and skills to enhance your GitHub Copilot experience',
    template: 'splash',
    pagefind: false,
    prev: false,
    next: false,
    editUrl: false,
    head: [{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } }],
  }}
  hasSidebar={false}
>
  <div id="main-content" class="v2-main">
    <!-- Hero Section -->
    <section class="ds-card v2-hero" data-color="neutral" aria-labelledby="hero-heading">
      <div class="v2-hero-content">
        <h1 id="hero-heading">Explore our growing hub for<br/>Agents, Skills & Instructions</h1>
        <p class="v2-hero-subtitle">
          DigDirs community-contributed agents, instructions, and skills to enhance your AI native experience
        </p>
        
        <div class="ds-search v2-hero-search">
          <label for="global-search" class="sr-only">Search all resources</label>
          <input
            type="search"
            id="global-search"
            class="ds-input"
            placeholder="Search for any agent, skill, instruction..."
            autocomplete="off"
          />
          <button type="button" class="ds-button v2-search-btn" data-icon aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="v2-search-icon" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <div id="search-results" class="search-results hidden" aria-label="Search results"></div>
        </div>
      </div>
      
      <div class="v2-hero-graphics" aria-hidden="true">
        <div class="v2-resource-stack">
          {cards.slice(0, 6).map((card) => (
            <div class="ds-card v2-resource-token" data-color="accent">
              <img src={`${base}${card.image}`} alt="" />
              <span>{card.title}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="v2-quick-links" aria-labelledby="quick-links-heading">
      <div class="v2-cards-grid">
        {cards.map(card => (
          <a href={`${base}${card.id}/`} class="ds-card v2-card" data-color="neutral" id={`card-${card.id}`}>
            <div class="v2-card-image-wrap">
               <img src={`${base}${card.image}`} alt={`${card.title} graphic`} />
            </div>
            <div class="v2-card-content">
              <h3>{card.title}</h3>
              <p class="v2-card-subtitle">
                {card.countId ? <span class="card-count" data-count={card.countId}>-</span> : <span></span>} 
                {card.countText}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <Modal />

  <script>
    import '../scripts/pages/index';
  </script>
</StarlightPage>

<style>
  :global(:root) {
    --sl-content-width: 1300px !important;
  }
  :global(.sl-container) {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 auto !important;
  }
  :global(.main-pane) {
    width: 100% !important;
  }
  #main-content.v2-main {
    max-width: 1300px;
    margin: 0 auto !important;
    padding: var(--ds-size-8);
  }

  .v2-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--ds-size-10);
    background: linear-gradient(135deg, var(--ds-color-neutral-surface-default), var(--ds-color-accent-surface-tinted));
    border-color: var(--ds-color-neutral-border-subtle);
    padding: var(--ds-size-12);
    position: relative;
    overflow: hidden;
    min-height: 480px;
    margin-bottom: var(--ds-size-10);
  }

  .v2-hero-content {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }

  .v2-hero h1 {
    font-size: clamp(2.5rem, 5vw, var(--ds-heading-2xl-font-size)) !important;
    line-height: 1.1 !important;
    font-weight: var(--ds-font-weight-bold) !important;
    color: var(--ds-color-neutral-text-default) !important;
    margin-bottom: var(--ds-size-6) !important;
    letter-spacing: 0 !important;
  }

  .v2-hero-subtitle {
    font-size: var(--ds-body-lg-font-size);
    color: var(--ds-color-neutral-text-subtle);
    margin-bottom: var(--ds-size-8);
    line-height: var(--ds-body-long-lg-line-height);
    max-width: 36rem;
  }

  .v2-hero-search {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  .v2-search-btn {
    grid-area: 1 / 2;
  }

  .v2-search-icon {
    stroke: currentColor;
    fill: none;
  }

  .v2-hero-graphics {
    position: relative;
    z-index: 1;
    width: min(42%, 420px);
  }

  .v2-resource-stack {
    display: grid;
    grid-template-columns: repeat(2, minmax(120px, 1fr));
    gap: var(--ds-size-4);
  }

  .v2-resource-token {
    display: grid;
    grid-template-columns: var(--ds-size-10) 1fr;
    align-items: center;
    gap: var(--ds-size-3);
    padding: var(--ds-size-4);
    color: var(--ds-color-accent-text-default);
    background: var(--ds-color-accent-surface-default);
  }

  .v2-resource-token img {
    width: var(--ds-size-10);
    height: var(--ds-size-10);
    object-fit: contain;
  }

  .v2-resource-token span {
    font-weight: var(--ds-font-weight-medium);
    color: var(--ds-color-accent-text-default);
  }

  .v2-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--ds-size-6);
  }
  @media (min-width: 1024px) {
    .v2-cards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .v2-card {
    overflow: hidden;
    text-decoration: none !important;
    display: flex !important;
    flex-direction: column;
    color: var(--ds-color-neutral-text-default);
    transition: transform 0.2s, box-shadow 0.2s;
    height: 260px;
    padding: 0;
  }

  .v2-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--ds-shadow-md);
  }

  .v2-card-image-wrap {
    height: 150px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--ds-size-3);
    border-radius: var(--ds-border-radius-md);
    overflow: hidden;
    background: var(--ds-color-accent-surface-tinted);
  }

  .v2-card-image-wrap img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .v2-card-content {
    padding: var(--ds-size-3) var(--ds-size-5) var(--ds-size-5);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .v2-card h3 {
    font-size: var(--ds-heading-xs-font-size) !important;
    font-weight: var(--ds-font-weight-bold) !important;
    margin: 0 0 var(--ds-size-2) 0 !important;
    line-height: 1.1 !important;
    color: var(--ds-color-neutral-text-default) !important;
  }

  .v2-card-subtitle {
    font-size: var(--ds-body-sm-font-size);
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
  }
  
  .v2-card-subtitle span {
    color: var(--ds-color-neutral-text-subtle);
  }

  @media (max-width: 900px) {
    #main-content.v2-main {
      padding: var(--ds-size-4);
    }

    .v2-hero {
      flex-direction: column;
      padding: var(--ds-size-6);
      align-items: stretch;
    }

    .v2-hero-content {
      max-width: 100%;
    }

    .v2-hero-graphics {
      width: 100%;
    }
  }
</style>
