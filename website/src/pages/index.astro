---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import projectSummaryData from '../../public/data/project-summary.json';

const base = import.meta.env.BASE_URL;
const splitLastWord = (value: string) => {
  const words = value.trim().split(/\s+/);
  const last = words.pop() ?? '';
  return {
    head: words.length ? `${words.join(' ')} ` : '',
    last,
  };
};
const toolsTitleParts = splitLastWord('Verktøy');
const projectTitleParts = splitLastWord(projectSummaryData.title ?? 'KI Prosjekter i BOD');
---

<StarlightPage
  frontmatter={{
    title: 'DigDir KI HUB',
    description: 'Godkjente KI-verktøy og aktive KI-prosjekter i BOD',
    template: 'splash',
    pagefind: false,
    prev: false,
    next: false,
    editUrl: false,
    head: [{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } }],
  }}
  hasSidebar={false}
>
  <div id="main-content" class="v2-main" data-page-color="accent">
    <section class="v2-hero" aria-labelledby="hero-heading">
      <p class="v2-kicker">Digdir / BOD / KITT-teamet</p>
      <h1 id="hero-heading" class="v2-hero-title">
        Kunstig intelligens<br />i <span>BOD</span>
      </h1>
      <p class="v2-hero-subtitle">
        Vi hjelper deg og ditt team i gang med verktøy og veiledning for en trygg og innovativ bruk av KI i offentlig sektor.
      </p>
      <div class="v2-hero-actions" aria-label="Hurtigvalg">
        <a class="ds-button v2-primary-action" href={`${base}tools/`}>
          Kom i gang
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a class="ds-button v2-secondary-action" data-variant="secondary" href={`${base}om-kitt/`}>
          Om KITT
        </a>
      </div>
    </section>

    <section class="v2-entry-section" aria-labelledby="entry-cards-heading">
      <h2 id="entry-cards-heading" class="v2-entry-heading">Snarveier</h2>
      <div class="v2-feature-grid">
        <a
          href={`${base}tools/`}
          class="v2-feature-card v2-tools-card ds-focus"
          data-color="accent"
          aria-label="Åpne katalog over verktøy"
        >
          <span class="v2-card-eyebrow">Katalog</span>
          <h3>
            {toolsTitleParts.head}<span class="v2-nowrap">
              {toolsTitleParts.last}<span class="v2-card-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </span>
          </h3>
        </a>

        <a
          href={`${base}prosjekter/`}
          class="v2-feature-card v2-project-card ds-focus"
          data-color="accent"
          aria-label="Se KI prosjekter i BOD"
        >
          <span class="v2-card-eyebrow">Oversikt</span>
          <h3>
            {projectTitleParts.head}<span class="v2-nowrap">
              {projectTitleParts.last}<span class="v2-card-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </span>
          </h3>
        </a>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  :global(:root) {
    --sl-content-width: 1220px !important;
  }

  :global(body:has(#main-content.v2-main)) {
    background: var(--ds-color-accent-background-default);
  }

  :global(.sl-container) {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 auto !important;
  }

  :global(.main-pane) {
    width: 100% !important;
  }

  #main-content.v2-main {
    box-sizing: border-box;
    width: min(100%, 1220px);
    margin: 0 auto !important;
    padding: var(--ds-size-12) var(--ds-size-8) var(--ds-size-16);
  }

  .v2-hero {
    max-width: 720px;
    padding: var(--ds-size-8) 0 var(--ds-size-6);
  }

  .v2-kicker {
    margin: 0;
    font-size: var(--ds-body-xs-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .v2-kicker {
    color: var(--ds-color-accent-text-subtle);
    margin-bottom: var(--ds-size-5);
  }

  .v2-hero-title {
    margin: 0;
    color: var(--ds-color-accent-text-default);
    font-size: var(--ds-heading-2xl-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .v2-hero-title span {
    color: var(--ds-color-accent-base-default);
  }

  .v2-hero-subtitle {
    max-width: 44rem;
    margin: var(--ds-size-6) 0 0;
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-long-lg-line-height);
  }

  .v2-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-3);
    margin-top: var(--ds-size-8);
  }

  .v2-primary-action,
  .v2-secondary-action {
    min-height: var(--ds-size-12);
    border-radius: var(--ds-border-radius-default);
    font-weight: var(--ds-font-weight-bold);
  }

  .v2-primary-action {
    --dsc-button-background: var(--ds-color-accent-base-default);
    --dsc-button-background--hover: var(--ds-color-accent-base-hover);
    --dsc-button-color: var(--ds-color-accent-base-contrast-default);
    --dsc-button-border-color: var(--ds-color-accent-base-default);
    --dsc-button-border-color--hover: var(--ds-color-accent-base-hover);
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
  }

  .v2-primary-action svg,
  .v2-card-arrow svg {
    width: var(--ds-size-5);
    height: var(--ds-size-5);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .v2-secondary-action {
    --dsc-button-border-color: var(--ds-color-accent-border-default);
    --dsc-button-border-color--hover: var(--ds-color-accent-border-strong);
    --dsc-button-color: var(--ds-color-accent-text-subtle);
    --dsc-button-color--hover: var(--ds-color-accent-text-default);
  }

  .v2-entry-section {
    margin-top: var(--ds-size-8);
  }

  .v2-entry-heading {
    margin: 0 0 var(--ds-size-8);
    color: var(--ds-color-accent-text-default);
    font-family: "PT Serif", Georgia, "Times New Roman", serif;
    font-size: var(--ds-heading-xl-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    line-height: 1.05;
  }

  .v2-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
  }

  .v2-feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 300px;
    padding: var(--ds-size-8);
    overflow: hidden;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    text-decoration: none !important;
    transition: filter 0.2s ease;
  }

  #main-content .v2-feature-card,
  #main-content .v2-feature-card:hover {
    text-decoration: none !important;
  }

  .v2-feature-card:hover {
    filter: brightness(0.98);
  }

  .v2-feature-card:focus-visible {
    outline: var(--ds-border-width-focus) solid var(--ds-color-focus-outer);
    outline-offset: var(--ds-size-1);
  }

  .v2-feature-card h3 {
    flex: 1;
    margin: var(--ds-size-5) 0 0;
    color: inherit;
    font-family: "PT Serif", Georgia, "Times New Roman", serif;
    font-size: var(--ds-heading-xl-font-size);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .v2-feature-card:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .v2-nowrap {
    white-space: nowrap;
  }

  .v2-card-eyebrow {
    order: -1;
    align-self: flex-start;
    margin: 0;
    padding: var(--ds-size-2) var(--ds-size-4);
    border-radius: var(--ds-border-radius-sm);
    background: var(--ds-color-accent-background-default);
    color: var(--ds-color-accent-text-default);
    font-size: var(--ds-body-md-font-size);
    font-weight: var(--ds-font-weight-medium);
    letter-spacing: 0;
    line-height: var(--ds-body-short-md-line-height);
  }

  .v2-tools-card {
    color: var(--ds-color-accent-base-contrast-default);
    background: var(--ds-color-accent-base-default);
  }

  #main-content a.v2-tools-card,
  #main-content a.v2-tools-card:hover {
    color: var(--ds-color-accent-base-contrast-default) !important;
  }

  .v2-project-card {
    color: var(--ds-color-accent-text-default);
    background: var(--ds-color-accent-surface-hover);
  }

  #main-content a.v2-project-card,
  #main-content a.v2-project-card:hover {
    color: var(--ds-color-accent-text-default) !important;
  }

  .v2-card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ds-size-10);
    height: var(--ds-size-10);
    margin-left: var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    background: var(--ds-color-accent-base-contrast-default);
    color: var(--ds-color-accent-base-default);
    vertical-align: middle;
    transform: translateY(-0.08em);
  }

  .v2-project-card .v2-card-arrow {
    background: var(--ds-color-accent-text-default);
    color: var(--ds-color-accent-surface-hover);
  }

  @media (max-width: 900px) {
    #main-content.v2-main {
      padding: var(--ds-size-8) var(--ds-size-5) var(--ds-size-12);
    }

    .v2-hero {
      max-width: none;
      padding-top: var(--ds-size-5);
    }

    .v2-hero-title {
      font-size: var(--ds-heading-xl-font-size);
    }

    .v2-feature-grid {
      grid-template-columns: 1fr;
    }

    .v2-entry-heading,
    .v2-feature-card h3 {
      font-size: var(--ds-heading-lg-font-size);
    }
  }

  @media (max-width: 560px) {
    #main-content.v2-main {
      padding-inline: var(--ds-size-4);
    }

    .v2-hero-title {
      font-size: var(--ds-heading-lg-font-size);
    }

    .v2-hero-subtitle {
      font-size: var(--ds-body-md-font-size);
      line-height: var(--ds-body-long-md-line-height);
    }

    .v2-feature-card {
      min-height: 240px;
      padding: var(--ds-size-6);
    }

    .v2-entry-heading,
    .v2-feature-card h3 {
      font-size: var(--ds-heading-md-font-size);
    }

    .v2-card-arrow {
      width: var(--ds-size-9);
      height: var(--ds-size-9);
      margin-left: var(--ds-size-2);
    }
  }
</style>
