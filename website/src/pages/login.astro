---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Logg inn',
    description: 'Innlogging for KI HUB',
    prev: false,
    next: false,
    editUrl: false,
  }}
  hasSidebar={false}
>
  <main id="main-content" class="placeholder-page">
    <h1>Logg inn</h1>
    <p>Dette er en midlertidig plassholder for innlogging. Autentisering er ikke koblet til ennå.</p>
  </main>
</StarlightPage>

<style>
  .placeholder-page {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--ds-size-12) var(--ds-size-8);
  }

  .placeholder-page h1 {
    margin: 0 0 var(--ds-size-4);
    color: var(--ds-color-neutral-text-default);
  }

  .placeholder-page p {
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
