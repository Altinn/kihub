---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import samplesData from '../../../../public/data/samples.json';
import Modal from '../../../components/Modal.astro';
import EmbeddedPageData from '../../../components/EmbeddedPageData.astro';
import {
  getRecipeResultsCountText,
  renderCookbookSectionsHtml,
} from '../../../scripts/pages/samples-render';

const initialRecipeMatches = samplesData.cookbooks.flatMap((cookbook) =>
  cookbook.recipes.map((recipe) => ({ cookbook, recipe }))
);

const languageOptions = Array.from(
  new Map(
    samplesData.cookbooks.flatMap((cookbook) =>
      cookbook.languages.map((language) => [language.id, language])
    )
  ).values()
);
---

<StarlightPage frontmatter={{ title: 'Cookbook', description: 'Code samples, recipes, and examples for building with GitHub Copilot' }}>
  <div class="cookbook-page">
    <div class="listing-toolbar">
      <div class="search-bar ds-search">
        <label for="search-input" class="sr-only">Search recipes</label>
        <input type="search" id="search-input" class="ds-input" placeholder="Search recipes..." autocomplete="off">
      </div>

      <div class="filters-bar" id="filters-bar">
        <div class="filter-group">
          <label for="filter-language">Language:</label>
          <select id="filter-language" class="ds-input" aria-label="Filter by language">
            <option value="">All Languages</option>
            {languageOptions.map((language) => (
              <option value={language.id}>{language.name}</option>
            ))}
          </select>
        </div>
        <div class="filter-group">
          <label for="filter-tag">Tags:</label>
          <select id="filter-tag" class="ds-input" multiple aria-label="Filter by tags">
            {samplesData.filters.tags.map((tag) => (
              <option value={tag}>{tag}</option>
            ))}
          </select>
        </div>
        <button id="clear-filters" class="ds-button" data-variant="secondary" data-size="sm">Clear Filters</button>
      </div>
    </div>

    <div class="results-count" id="results-count" aria-live="polite">{getRecipeResultsCountText(samplesData.totalRecipes, samplesData.totalRecipes)}</div>

    <div id="samples-list" role="list" set:html={renderCookbookSectionsHtml(initialRecipeMatches)}></div>
  </div>

  <Modal />
  <EmbeddedPageData filename="samples.json" data={samplesData} />

  <style is:global>
    /* Cookbook Section */
    .cookbook-section {
      margin-bottom: var(--ds-size-10);
    }

    .cookbook-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--ds-size-6);
      margin-bottom: var(--ds-size-6);
      padding-bottom: var(--ds-size-4);
      border-bottom: var(--ds-border-width-default) solid var(--ds-color-neutral-border-subtle);
    }

    .cookbook-info h2 {
      margin: 0 0 var(--ds-size-2) 0;
      font-size: var(--ds-heading-xs-font-size);
      color: var(--ds-color-neutral-text-default);
    }

    .cookbook-info p {
      margin: 0;
      color: var(--ds-color-neutral-text-subtle);
    }

    .cookbook-languages {
      display: flex;
      gap: var(--ds-size-2);
      flex-shrink: 0;
    }

    .lang-tab {
      font-family: 'Monaspace Argon NF', monospace;
      font-size: var(--ds-body-md-font-size);
    }

    .lang-tab:hover {
      border-color: var(--ds-color-accent-border-default);
    }

    .lang-tab.active {
      border-color: var(--ds-color-accent-base-default);
      background: var(--ds-color-accent-base-default);
      color: var(--ds-color-accent-base-contrast-default);
    }

    /* Recipe Grid */
    .recipes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: var(--ds-size-5);
    }

    /* Recipe Card */
    .recipe-card {
      transition: all var(--transition);
    }

    .recipe-card:hover {
      box-shadow: var(--ds-shadow-sm);
    }

    .recipe-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--ds-size-3);
      margin-bottom: var(--ds-size-3);
    }

    .recipe-header h3 {
      margin: 0;
      font-size: var(--ds-heading-2xs-font-size);
      color: var(--ds-color-neutral-text-default);
    }

    .recipe-langs {
      display: flex;
      gap: var(--ds-size-1);
      flex-shrink: 0;
    }

    .lang-indicator {
      font-family: 'Monaspace Argon NF', monospace;
      font-size: var(--ds-body-md-font-size);
      opacity: 0.7;
    }

    .recipe-description {
      color: var(--ds-color-neutral-text-subtle);
      font-size: var(--ds-body-sm-font-size);
      margin: 0 0 var(--ds-size-4) 0;
      line-height: var(--ds-body-long-sm-line-height);
    }

    .recipe-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ds-size-2);
      margin-bottom: var(--ds-size-4);
    }

    .recipe-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ds-size-2);
      padding-top: var(--ds-size-4);
      border-top: var(--ds-border-width-default) solid var(--ds-color-neutral-border-subtle);
    }

    .no-variant {
      color: var(--ds-color-neutral-text-subtle);
      font-size: var(--ds-body-sm-font-size);
      font-style: italic;
    }

    /* External recipe card */
    .recipe-card.external {
      border-style: dashed;
    }

    .recipe-badge.external-badge {
      white-space: nowrap;
    }

    .recipe-author-line {
      margin-bottom: var(--ds-size-3);
      font-size: var(--ds-body-sm-font-size);
      color: var(--ds-color-neutral-text-subtle);
    }

    .recipe-author-line a {
      color: var(--ds-color-accent-text-subtle);
      text-decoration: none;
    }

    .recipe-author-line a:hover {
      text-decoration: underline;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: var(--ds-size-12) var(--ds-size-6);
      border-style: dashed;
    }

    .empty-state h3 {
      margin: 0 0 var(--ds-size-2) 0;
      color: var(--ds-color-neutral-text-subtle);
    }

    .empty-state p {
      margin: 0;
      color: var(--ds-color-neutral-text-subtle);
    }

    /* Search highlight */
    .search-highlight {
      background-color: var(--ds-color-warning-surface-tinted);
      color: var(--ds-color-warning-text-default);
      padding: 0 2px;
      border-radius: var(--ds-border-radius-sm);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .cookbook-header {
        flex-direction: column;
      }

      .recipes-grid {
        grid-template-columns: 1fr;
      }

      .recipe-actions {
        flex-direction: column;
      }

      .recipe-actions .ds-button {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script>
    import '../../../scripts/pages/samples';
  </script>
</StarlightPage>
