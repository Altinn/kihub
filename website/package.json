    "choices.js": "^11.1.0",
    "devalue": "^5.7.1",
    "form-data": "^4.0.5",
    "front-matter": "^4.0.2",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "marked": "^18.0.0",
    "qs": "^6.15.1",
    "shiki": "^4.0.0",
