  "version": "1.0.0",
  "description": "KI Hub website - browse agents, skills, instructions, and plugins",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run design:build",
    "build": "astro build",
    "design:tokens": "designsystemet tokens create --config designsystemet.config.json",
