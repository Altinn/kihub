{
  "name": "@kihub/artifact-schema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned contract for the KI Hub artifact.yaml manifest — Zod schema, validator, generated JSON Schema, and docs.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema.json": "./schema/artifact.schema.json"
  },
  "bin": {
    "artifact-schema": "./scripts/validate-file.ts"
  },
  "scripts": {
    "test": "vitest run",
    "validate": "tsx scripts/validate-file.ts",
    "generate:jsonschema": "tsx scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "vitest": "4.1.9"
  }
}
