[
  {
    "op": "find",
    "collection": "events",
    "where": {
      "and": [
        {
          "status": {
            "equals": "published"
          }
        },
        {
          "or": [
            {
              "endDateTime": {
                "greater_than_equal": "2026-10-15T08:00:00.000Z"
              }
            },
            {
              "and": [
                {
                  "endDateTime": {
                    "exists": false
                  }
                },
                {
                  "startDateTime": {
                    "greater_than_equal": "2026-10-15T08:00:00.000Z"
                  }
                }
              ]
            }
          ]
        },
        {
          "eventType": {
            "in": [
              "webinar"
            ]
          }
        },
        {
          "format": {
            "equals": "digitalt"
          }
        }
      ]
    },
    "sort": "startDateTime",
    "limit": 200,
    "page": 1,
    "overrideAccess": true
  }
]
