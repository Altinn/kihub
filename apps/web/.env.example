# --- Database (Payload) ---
DATABASE_URI=postgres://kihub:kihub@localhost:55432/kihub

# DB auth mode: "password" (default — credentials in DATABASE_URI, local docker) or "entra"
# (Azure: no password in the URI; a per-connection Entra token is fetched via
# DefaultAzureCredential — managed identity in Azure. Keep sslmode=require in the URI).
DB_AUTH_MODE=password

# Payload encryption secret (any long random string)
PAYLOAD_SECRET=change-me-dev-only-secret

# --- Auth (Auth.js v5) ---
# Session/JWT signing secret (any long random string)
AUTH_SECRET=change-me-dev-only-auth-secret

# Auth mode: "mock" (local dev, no Entra needed) or "entra" (real Azure Entra ID)
AUTH_MODE=mock

# --- Catalog indexing (Phase 2, retained break-glass fallback) ---
# Path to a local checkout of the sibling ai-artifacts repo, indexed by `pnpm --filter web index`.
# Use an absolute path (the indexer runs with its working dir in apps/web).
AI_ARTIFACTS_PATH=/absolute/path/to/ai-artifacts

# --- Automated discovery (Phase 4) ---
# GitHub token used to fetch artifact content remotely. Each discovery-sources record names the
# env var it reads via its `tokenEnvVar` field (the token value is never stored in the database).
GITHUB_TOKEN_AI_ARTIFACTS=
# Shared secret the external scheduler sends as the `X-Discovery-Scan-Key` header to POST
# /api/discovery/scan. Any long random string.
DISCOVERY_SCAN_KEY=change-me-dev-only-scan-key
# NOTE: each source's webhook HMAC secret is stored on its discovery-sources record (hidden,
# Admin-only) — configure the matching secret on the GitHub webhook, not here.

# The organization's home tenant id — used by the employee gate to reject other tenants.
# In mock mode this is the tenant the "member" persona belongs to.
ORG_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Real Entra ID (only used when AUTH_MODE=entra) ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- Learning media uploads (014) ---
# Where uploaded images (the `media` collection) are stored: "disk" (default — the local
# filesystem under apps/web/media, for local dev) or "azure" (Azure Blob Storage, for deployed
# environments). The container filesystem is EPHEMERAL, so "disk" in a deployed environment means
# uploaded images disappear on restart — see specs/014-learning-pages/contracts/media-storage.md §C.
MEDIA_STORAGE_MODE=disk

# Required when MEDIA_STORAGE_MODE=azure. A missing or blank value throws at startup rather than
# silently serving broken images (FR-025).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
# Optional: public base URL for served blobs.
AZURE_STORAGE_ACCOUNT_BASEURL=
