{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "index": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/index-artifacts.ts",
    "discovery:scan": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/discovery-scan.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "theme:build": "designsystemet tokens create --yes --clean && designsystemet tokens build --clean",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@digdir/designsystemet-css": "1.21.0",
    "@digdir/designsystemet-react": "1.21.0",
    "@kihub/artifact-schema": "workspace:*",
    "@kihub/discovery-core": "workspace:*",
    "@kihub/github-client": "workspace:*",
    "@kihub/governance-core": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-azure": "3.88.0",
    "@shikijs/langs": "4.4.3",
    "graphql": "^16.8.1",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.3",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@digdir/designsystemet": "1.21.0",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  }
}
